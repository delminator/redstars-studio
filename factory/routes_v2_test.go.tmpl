// GENERATED by redstars-studio — every route against a fake core that compiles
// each data request against schema.json (a wrong table/column fails go test).
package main

import (
	"bytes"
	"encoding/json"
	"io"
	"net/http"
	"net/http/httptest"
	"regexp"
	"strings"
	"sync"
	"testing"

	"github.com/delminator/redstars/backend/pkg/appdata"
	"github.com/delminator/redstars/backend/pkg/coresdk"
	"github.com/gin-gonic/gin"
)

// TestEveryRouteSpeaksV2 calls every route against a fake core that
// COMPILES each data request against schema.json exactly like core does.
// Any request core would refuse (unknown table/column, bad grammar) or any
// leftover v1 path (RawQuery, org-db, app-common) fails the test.
func TestEveryRouteSpeaksV2(t *testing.T) {
	sch, err := appdata.ParseSchema("__APP__", schemaJSON)
	if err != nil {
		t.Fatal(err)
	}
	var mu sync.Mutex
	current := ""
	withRow := false
	row := `{"id":1,"game_id":1,"member_id":1,"user_id":1,"status":"active","name":"x","member_tag":"t","end_date":"2030-01-01T00:00:00Z","due_date":"2020-01-01T00:00:00Z","value":1,"n":1,"renew_count":0,"price_paid":5,"extra":{},"contributors":[],"tags":[]}`
	var problems []string
	seen := 0
	compileOne := func(scope, op string, body []byte) error {
		var err error
		switch op {
		case "query":
			var r appdata.QueryReq
			if err = appdata.Decode(body, &r); err == nil {
				r.Scope = scope
				_, err = appdata.CompileQuery(sch, &r)
			}
		case "insert":
			var r appdata.InsertReq
			if err = appdata.Decode(body, &r); err == nil {
				r.Scope = scope
				_, err = appdata.CompileInsert(sch, &r)
			}
		case "update":
			var r appdata.UpdateReq
			if err = appdata.Decode(body, &r); err == nil {
				r.Scope = scope
				_, err = appdata.CompileUpdate(sch, &r)
			}
		case "delete":
			var r appdata.DeleteReq
			if err = appdata.Decode(body, &r); err == nil {
				r.Scope = scope
				_, err = appdata.CompileDelete(sch, &r)
			}
		}
		return err
	}
	fake := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		body, _ := io.ReadAll(r.Body)
		p := r.URL.Path
		w.Header().Set("Content-Type", "application/json")
		switch {
		case strings.HasPrefix(p, "/internal/data/"):
			parts := strings.Split(strings.TrimPrefix(p, "/internal/data/"), "/")
			scope, op := parts[0], parts[1]
			var errs []string
			n := 1
			if op == "batch" {
				var br appdata.BatchReq
				if err := appdata.Decode(body, &br); err != nil {
					errs = append(errs, err.Error())
				}
				n = len(br.Ops)
				for _, o := range br.Ops {
					if err := compileOne(scope, o.Op, o.Req); err != nil {
						errs = append(errs, o.Op+": "+err.Error()+" "+string(o.Req))
					}
				}
			} else if err := compileOne(scope, op, body); err != nil {
				errs = append(errs, err.Error()+" "+string(body))
			}
			mu.Lock()
			seen++
			for _, e := range errs {
				problems = append(problems, current+": "+e)
			}
			mu.Unlock()
			if len(errs) > 0 {
				w.WriteHeader(400)
				_, _ = w.Write([]byte(`{"error":"refused"}`))
				return
			}
			if op == "batch" {
				res := make([]map[string]any, n)
				for i := range res {
					res[i] = map[string]any{"rows": []any{}}
					if withRow {
						res[i] = map[string]any{"rows": []json.RawMessage{json.RawMessage(row)}}
					}
				}
				_ = json.NewEncoder(w).Encode(map[string]any{"results": res})
				return
			}
			if withRow {
				_, _ = w.Write([]byte(`{"rows":[` + row + `],"count":1}`))
				return
			}
			_, _ = w.Write([]byte(`{"rows":[],"count":0}`))
		case strings.Contains(p, "/internal/org-db") || strings.Contains(p, "/internal/app-common") ||
			strings.Contains(p, "/query") && !strings.HasPrefix(p, "/internal/data/"):
			mu.Lock()
			problems = append(problems, current+": v1 data path "+p)
			mu.Unlock()
			w.WriteHeader(410)
		default:
			_, _ = w.Write([]byte(`{"id":1,"user_id":1,"role":"admin","data":[],"count":0}`))
		}
	}))
	defer fake.Close()

	core = coresdk.NewClient(fake.URL, "__APP__", "test-key")
	if err := core.EnableDataV2(schemaJSON); err != nil {
		t.Fatal(err)
	}
	gin.SetMode(gin.TestMode)
	r := gin.New()
	r.Use(gin.Recovery())
	registerAPI(r.Group("/api/v1/__APP__"))

	param := regexp.MustCompile(`[:*][a-zA-Z_]+`)
	for _, wr := range []bool{false, true} {
		withRow = wr
		for _, rt := range r.Routes() {
			path := param.ReplaceAllString(rt.Path, "1")
			for _, body := range []string{`{}`} {
				req := httptest.NewRequest(rt.Method, path, bytes.NewBufferString(body))
				req.Header.Set("Content-Type", "application/json")
				req.Header.Set("Authorization", "Bearer x")
				req.Header.Set("X-Organization-OID", "AB-CD-EF:local:test:1")
				w := httptest.NewRecorder()
				// tag the outgoing core calls with the route under test
				mu.Lock()
				current = rt.Method + " " + rt.Path
				mu.Unlock()
				r.ServeHTTP(w, req)
			}
		}
	}
	t.Logf("%d routes, %d data requests compiled", len(r.Routes()), seen)
	for _, p := range problems {
		// an empty client body legitimately has nothing to write
		if strings.Contains(p, ": no values {") || strings.Contains(p, ": nothing to set {") {
			continue
		}
		t.Error(p)
	}
}
